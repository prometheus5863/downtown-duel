# Godot cache & builds
.godot/
export/
*.tmp

# Raw asset formats Godot doesn't use (glTF versions are committed)
assets/**/FBX*/
assets/**/OBJ/
assets/**/Blends/
assets/**/Unity/
assets/**/Textures/
assets/monsters/Exports/
*.blend
*.blend1

# OS / editor
.DS_Store
Thumbs.db

